# Slack tokens
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token

# Optional but useful for constructing Slack canvas links when Slack does not return one.
SLACK_TEAM_ID=T0123456789

# Premday defaults
PREMDAY_TIMEZONE=Europe/Paris
PREMDAY_DEFAULT_HOUR=18
PREMDAY_DEFAULT_DURATION_MINUTES=90
PREMDAY_DB_PATH=premday.sqlite3
# Docker Compose overrides PREMDAY_DB_PATH with /data/premday.sqlite3.

# SMTP invitation delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=bot@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PREMDAY_EMAIL_FROM="Premday <rsvp@example.com>"

# OpenSMTPD forwards calendar replies to this loopback-only listener.
RSVP_EMAIL_ADDRESS=rsvp@example.com
RSVP_SMTP_HOST_PORT=2525

# IMMAP polls
IMMAP_ADMIN_EMAILS=a.rougemont@criteo.com
IMMAP_REMINDER_HOURS=24
